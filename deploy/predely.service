[Unit]
Description=Пределы Галактики — сервер онлайн-партий
After=network.target

[Service]
WorkingDirectory=/opt/predelgalactiki
ExecStart=/usr/bin/env node /opt/predelgalactiki/server.js
Environment=PORT=80
# позволяет слушать порт 80 без прав root
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
User=predely

[Install]
WantedBy=multi-user.target
